name: tinyaxum@SVC_SUFFIX@
services:
  backend:
    image: tinyaxum@SVC_SUFFIX@:@VERSION@
    container_name: tinyaxum@SVC_SUFFIX@
    pull_policy: never
    restart: unless-stopped
    volumes:
      - ./config.toml:/app/config.toml:ro
      - ./data:/app/data
      - ./logs:/app/logs
    ports:
      - "3001:3001"
